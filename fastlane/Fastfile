def asc_api_key
  key_content = ENV.fetch("ASC_KEY_P8_BASE64")
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: Base64.decode64(key_content),
    is_key_content_base64: false
  )
end

def increment_build_number_safe
  increment_build_number(
    build_number: Time.now.utc.strftime("%Y%m%d%H%M")
  )
end

platform :ios do
  desc "Build signed IPA and upload StickMe to TestFlight"
  lane :beta do
    api_key = asc_api_key
    increment_build_number_safe
    build_app(
      workspace: "ios/StickMe.xcworkspace",
      scheme: "StickMe",
      configuration: "Release",
      export_method: "app-store",
      export_options: "ios/exportOptions.plist",
      output_directory: "build",
      output_name: "StickMe.ipa",
      clean: true
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false
    )
  end
end
